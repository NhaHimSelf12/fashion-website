{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.1"
    }
  },
  "routes": [
    {
      "src": "/build/(.*)",
      "dest": "/public/build/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "env": {
    "APP_CONFIG_CACHE": "/tmp/config.php",
    "VIEW_COMPILED_PATH": "/tmp"
  },
  "outputDirectory": "public"
}
